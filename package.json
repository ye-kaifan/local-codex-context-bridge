{
  "name": "local-codex-context-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only native Codex context for ChatGPT Chat and Dot through MCP.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ye-kaifan/local-codex-context-bridge.git"
  },
  "files": [
    "dist/src",
    "bridge",
    "scripts",
    "docs",
    "examples",
    "licenses",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh-CN.md",
    "INSTALL.md",
    "PROTOCOL-ASSUMPTIONS.md",
    "macos",
    "templates",
    "upstream-files.json",
    "windows"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test dist/test/*.test.js test/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepack": "npm run build",
    "check:native-schema": "node scripts/check-native-schema.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
